# ==============================================================================
# KickPredict Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual secrets.
# DO NOT commit .env with real credentials to version control!
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kickpredict?sslmode=require
DB_POOL_MAX=10

# Secret for signing session JWTs (minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_character_minimum_random_secret_here

# Kick OAuth 2.1 Credentials
# Set the redirect URI exactly as configured in your Kick Developer Portal.
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
KICK_REDIRECT_URI=http://localhost:4000/api/auth/kick/callback

# Frontend Origin and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Football Data API (football-data.org - Free tier supports PL, PD, BL1, SA, FL1, CL)
FOOTBALL_DATA_API_KEY=your_football_data_org_api_key
COMPETITION_CODES=PL,PD,BL1,SA,FL1,CL

# Match sync frequency cron (Default: every 5 minutes; 6 competitions synced over ~35s with 7s gap = 6 req/min, well under 10 req/min limit)
SYNC_CRON=*/5 * * * *

# Prediction Game Rules
MAX_BOOSTS_PER_MATCHDAY=1

# Optional Bookmaker Odds Provider ('the-odds-api' or 'api-football')
# Leave keys blank to disable odds refresh and rely on Poisson expected goals engine.
ODDS_PROVIDER=the-odds-api
THE_ODDS_API_KEY=
API_FOOTBALL_KEY=
ODDS_BOOKMAKER_KEY=williamhill
ODDS_REGIONS=uk
ODDS_CRON=10 6 * * *
ODDS_WINDOW_DAYS=7
ODDS_CALL_DELAY_MS=1000

# Optional Tunisia Ligue 1 Sync (requires API-Football plan covering this league & season)
TUNISIA_LEAGUE_ID=202
TUNISIA_SEASON=

# Local-only demo fixture generator; NEVER set to true in production.
ALLOW_DEMO_DATA=false
